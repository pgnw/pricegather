generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String
  name  String?
}

model Product {
  id          Int     @id // Keep on eye on aldi's product ids, not sure if it will fit into an integer field.
  store       Store   @relation(fields: [storeId], references: [id])
  storeId     Int
  name        String
  description String
  grams       Int
  price       Decimal // TODO replace this with a seperate table to track price changes over time.
}

model Store {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}
