generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String
  name  String?
}

model Product {
  id          String  @id
  store       Store   @relation(fields: [storeId], references: [id])
  storeId     Int
  name        String
  description String?
  grams       Int?
  price       Float // TODO replace this with a seperate table to track price changes over time.
}

model Store {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  products        Product[]
  storeCategories StoreCategory[]
}

model StoreCategory {
  id       Int    @id @default(autoincrement())
  store    Store  @relation(fields: [storeId], references: [id])
  storeId  Int
  category String
}
