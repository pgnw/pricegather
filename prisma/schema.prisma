generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String
  name  String?
}

model Product {
  id                String           @id
  store             Store            @relation(fields: [storeId], references: [id])
  storeId           Int
  name              String
  description       String?
  grams             Int?
  price             Float // TODO replace this with a seperate table to track price changes over time.
  url               String
  measurementType   measurementType? @relation(fields: [measurementTypeId], references: [id])
  measurementTypeId Int?
}

model measurementType {
  id              Int       @id @default(autoincrement())
  measurementType String
  products        Product[]
}

model Store {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  products        Product[]
  storeCategories StoreCategory[]
}

model StoreCategory {
  id       Int    @id @default(autoincrement())
  store    Store  @relation(fields: [storeId], references: [id])
  storeId  Int
  category String
}
